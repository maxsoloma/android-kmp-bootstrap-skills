package {{PACKAGE_BASE}}.core.network.api

import kotlinx.serialization.json.Json
import kotlin.test.Test
import kotlin.test.assertEquals

class UserDtoTest {

    private val json = Json { ignoreUnknownKeys = true }

    @Test
    fun decodesSnakeCasePayloadIntoUserDto() {
        val payload = """{"id":7,"display_name":"Ann","email":"ann@example.com"}"""
        val decoded = json.decodeFromString(UserDto.serializer(), payload)
        assertEquals(UserDto(id = 7, displayName = "Ann", email = "ann@example.com"), decoded)
    }

    @Test
    fun decodesPayloadWithMissingOptionalEmail() {
        val payload = """{"id":3,"display_name":"Bo"}"""
        val decoded = json.decodeFromString(UserDto.serializer(), payload)
        assertEquals(UserDto(id = 3, displayName = "Bo", email = null), decoded)
    }
}
