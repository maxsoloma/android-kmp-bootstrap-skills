package {{PACKAGE_BASE}}.core.di

import kotlinx.coroutines.Dispatchers
import org.koin.dsl.koinApplication
import kotlin.test.Test
import kotlin.test.assertSame

class CoreModuleTest {

    @Test
    fun defaultDispatchersExposeStandardKotlinDispatchers() {
        val dispatchers = DefaultAppDispatchers
        assertSame(Dispatchers.Default, dispatchers.default)
        assertSame(Dispatchers.Main, dispatchers.main)
    }

    @Test
    fun coreModuleResolvesAppDispatchers() {
        val app = koinApplication { modules(coreModule) }
        val resolved = app.koin.get<AppDispatchers>()
        assertSame(DefaultAppDispatchers, resolved)
        app.close()
    }
}
