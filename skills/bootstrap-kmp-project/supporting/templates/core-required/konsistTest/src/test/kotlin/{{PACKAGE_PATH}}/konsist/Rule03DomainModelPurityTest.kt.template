package {{PACKAGE_BASE}}.konsist

import com.lemonappdev.konsist.api.verify.assertFalse
import org.junit.jupiter.api.Test

class Rule03DomainModelPurityTest {

    private val forbiddenAnnotations = listOf(
        "Serializable", "SerialName",
        "Entity", "PrimaryKey", "ColumnInfo", "Embedded", "TypeConverter",
    )

    @Test
    fun `rule 03 - classes in domain model carry no serialization or persistence annotations`() {
        ProjectScope.commonMain
            .classes()
            .filter { it.resideInPackage("..domain.model..") }
            .assertFalse { clazz ->
                clazz.annotations.any { annotation ->
                    forbiddenAnnotations.any { annotation.name == it }
                }
            }
    }
}
