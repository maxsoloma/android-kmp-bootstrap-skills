package {{PACKAGE_BASE}}.konsist

import com.lemonappdev.konsist.api.verify.assertTrue
import org.junit.jupiter.api.Test

class Rule06MapperConformanceTest {

    @Test
    fun `rule 06 - classes ending in Mapper implement core domain mappers Mapper`() {
        ProjectScope.commonMain
            .classes()
            .filter { it.name.endsWith("Mapper") }
            .assertTrue { mapper ->
                mapper.parents().any { it.name.substringBefore("<") == "Mapper" }
            }
    }
}
