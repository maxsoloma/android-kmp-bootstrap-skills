package {{PACKAGE_BASE}}.konsist

import com.lemonappdev.konsist.api.verify.assertTrue
import org.junit.jupiter.api.Test

class Rule04RepositoryPairingTest {

    @Test
    fun `rule 04 - each domain repository interface has exactly one data implementation`() {
        val implementations = ProjectScope.commonMain
            .classes()
            .filter { it.resideInPackage("..data.repository..") }

        ProjectScope.commonMain
            .interfaces()
            .filter { it.resideInPackage("..domain.repository..") && it.name.endsWith("Repository") }
            .assertTrue { repo ->
                implementations.count { impl ->
                    impl.parents().any { it.name == repo.name }
                } == 1
            }
    }
}
