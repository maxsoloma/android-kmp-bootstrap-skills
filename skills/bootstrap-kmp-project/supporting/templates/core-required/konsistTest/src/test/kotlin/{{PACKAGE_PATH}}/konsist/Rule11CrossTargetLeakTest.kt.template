package {{PACKAGE_BASE}}.konsist

import com.lemonappdev.konsist.api.ext.list.functions
import com.lemonappdev.konsist.api.verify.assertFalse
import org.junit.jupiter.api.Test

class Rule11CrossTargetLeakTest {

    private val platformTypeNames: Set<String> by lazy {
        (ProjectScope.androidMain.classes(includeNested = true) +
            ProjectScope.androidMain.interfaces() +
            ProjectScope.iosMain.classes(includeNested = true) +
            ProjectScope.iosMain.interfaces())
            .map { it.name }
            .toSet()
    }

    @Test
    fun `rule 11 - no androidMain or iosMain type appears in a public commonMain signature`() {
        ProjectScope.commonMain
            .functions(includeNested = true)
            .filter { it.hasPublicOrDefaultModifier }
            .assertFalse { function ->
                val sigTypes = buildList {
                    function.returnType?.name?.let { add(it) }
                    addAll(function.parameters.map { it.type.name })
                }
                sigTypes.any { it in platformTypeNames }
            }
    }
}
