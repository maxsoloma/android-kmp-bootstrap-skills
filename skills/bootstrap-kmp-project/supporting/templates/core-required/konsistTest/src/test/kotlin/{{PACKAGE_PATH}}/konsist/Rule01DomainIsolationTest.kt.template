package {{PACKAGE_BASE}}.konsist

import com.lemonappdev.konsist.api.ext.list.imports
import com.lemonappdev.konsist.api.verify.assertFalse
import org.junit.jupiter.api.Test

class Rule01DomainIsolationTest {

    private val forbidden = listOf(
        ".data.",
        ".presentation.",
        ".ui.",
        ".database.entity.",
        ".network.api.",
    )

    @Test
    fun `rule 01 - domain repository and usecase files import no data, presentation, ui, entity or network-api`() {
        ProjectScope.commonMain.files
            .filter {
                it.resideInPath("..domain/repository..", absolutePath = false) ||
                    it.resideInPath("..domain/usecase..", absolutePath = false)
            }
            .imports
            .assertFalse { import ->
                forbidden.any { import.name.contains(it) }
            }
    }
}
