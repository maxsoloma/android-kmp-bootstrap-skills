# Tunables for the Konsist architecture rules. Read by ProjectScope / rule tests.
viewModelMaxParams: 8
# Import prefixes commonMain MAY use beyond kotlin.* (rule 10 allowlist).
# kotlinx.cinterop is intentionally absent — it is platform-specific (iOS/Native only)
# and must not appear in commonMain. Using specific sub-packages instead of broad "kotlinx."
# ensures the kotlinx.cinterop prohibition in forbiddenPrefixes is never neutralised.
commonMainImportAllowlist:
  - "androidx.compose."
  - "androidx.lifecycle."
  - "androidx.navigation."
  - "org.jetbrains.compose."
  - "io.ktor."
  - "org.koin."
  - "coil3."
  - "kotlinx.coroutines."
  - "kotlinx.serialization."
  - "kotlinx.datetime."
  - "kotlinx.collections."
  - "kotlinx.io."
  - "kotlin."
