plugins {
    id("{{PACKAGE_BASE}}.convention.compose-multiplatform")
    id("{{PACKAGE_BASE}}.convention.detekt")
}

kotlin {
    androidLibrary {
        namespace = "{{PACKAGE_BASE}}.core.resources"
    }
}

compose.resources {
    // Res MUST be public: feature module is a separate module and cannot see the
    // default `internal` accessor. Explicit package makes STAGE B substitution deterministic.
    publicResClass = true
    generateResClass = always
    packageOfResClass = "{{PACKAGE_BASE}}.core.resources"
}
