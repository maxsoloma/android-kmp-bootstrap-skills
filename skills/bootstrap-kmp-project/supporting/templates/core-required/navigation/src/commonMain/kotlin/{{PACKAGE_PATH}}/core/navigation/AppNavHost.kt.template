package {{PACKAGE_BASE}}.core.navigation

import androidx.compose.runtime.Composable
import androidx.navigation.NavGraphBuilder
import androidx.navigation.NavHostController
import androidx.navigation.compose.NavHost
import androidx.navigation.compose.rememberNavController

/**
 * Root navigation scaffold. Start destination is [Routes.{{FEATURE_NAME}}]. Feature modules
 * contribute their `composable<...>` graphs via [builder]; this module stays
 * decoupled from any concrete feature (no `feature:*` import here).
 */
@Composable
fun AppNavHost(
    navController: NavHostController = rememberNavController(),
    builder: NavGraphBuilder.(NavHostController) -> Unit,
) {
    NavHost(navController = navController, startDestination = Routes.{{FEATURE_NAME}}) {
        builder(navController)
    }
}
