package {{PACKAGE_BASE}}.core.design.theme

import androidx.compose.foundation.isSystemInDarkTheme
import androidx.compose.material3.MaterialTheme
import androidx.compose.runtime.Composable

/**
 * Root Compose Multiplatform theme. Named `<ProjectName>Theme` in the generated
 * project. Shared by Android + iOS — dynamic color is opt-in per platform and
 * intentionally omitted from common.
 */
@Composable
fun {{PROJECT_NAME}}Theme(
    darkTheme: Boolean = isSystemInDarkTheme(),
    content: @Composable () -> Unit,
) {
    MaterialTheme(
        colorScheme = if (darkTheme) DarkColors else LightColors,
        content = content,
    )
}
