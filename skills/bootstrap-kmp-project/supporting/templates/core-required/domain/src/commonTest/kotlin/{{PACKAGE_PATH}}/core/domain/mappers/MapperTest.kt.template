package {{PACKAGE_BASE}}.core.domain.mappers

import kotlin.test.Test
import kotlin.test.assertEquals

class MapperTest {

    private data class From(val raw: Int)
    private data class To(val value: String)

    private val intToStringMapper = object : Mapper<From, To> {
        override fun map(from: From): To = To(from.raw.toString())
    }

    @Test
    fun mapTransformsSingleValue() {
        assertEquals(To("42"), intToStringMapper.map(From(42)))
    }

    @Test
    fun mapListTransformsEachElement() {
        val result = intToStringMapper.mapList(listOf(From(1), From(2)))
        assertEquals(listOf(To("1"), To("2")), result)
    }
}
