build:
  maxIssues: 0
config:
  validation: true
  warningsAsErrors: false
naming:
  FunctionNaming:
    active: true
    ignoreAnnotated: ['Composable']
    excludes: ['**/build/generated/**']
style:
  MaxLineLength:
    active: true
    excludes: ['**/build/generated/**']
  MagicNumber:
    active: true
    excludes: ['**/build/generated/**']
Compose:
  active: true
  ComposableNaming:
    active: true
  ComposableParamOrder:
    active: true
  ModifierComposed:
    active: true
  ModifierMissing:
    active: true
