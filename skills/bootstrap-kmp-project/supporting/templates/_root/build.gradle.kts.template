tasks.register("failIfDetektBaselineExists") {
    group = "verification"
    description = "Fails if any detekt-baseline.xml exists — zero-baseline policy."
    doLast {
        val baselines = rootProject.rootDir
            .walkTopDown()
            .filter { it.isFile && it.name == "detekt-baseline.xml" }
            .filterNot { it.path.contains("${File.separator}build${File.separator}") }
            .toList()
        if (baselines.isNotEmpty()) {
            throw org.gradle.api.GradleException(
                "Detekt baseline files are forbidden (zero-baseline policy). Found:\n" +
                    baselines.joinToString("\n") { " - ${it.relativeTo(rootProject.rootDir)}" } +
                    "\nDo not generate a baseline to silence violations. Add // SUPPRESS-RATIONALE: instead.",
            )
        }
    }
}

tasks.matching { it.name == "check" }.configureEach { dependsOn("failIfDetektBaselineExists") }
