package {{PACKAGE_BASE}}.feature.{{FEATURE_NAME}}.presentation

import {{PACKAGE_BASE}}.feature.{{FEATURE_NAME}}.domain.GetGreetingUseCase
import {{PACKAGE_BASE}}.feature.{{FEATURE_NAME}}.domain.Greeting
import {{PACKAGE_BASE}}.feature.{{FEATURE_NAME}}.domain.GreetingRepository
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.test.StandardTestDispatcher
import kotlinx.coroutines.test.resetMain
import kotlinx.coroutines.test.runTest
import kotlinx.coroutines.test.setMain
import kotlin.test.AfterTest
import kotlin.test.BeforeTest
import kotlin.test.Test
import kotlin.test.assertEquals
import kotlin.test.assertFalse

private class FakeGreetingRepository(
    private val response: Greeting = Greeting("Hello, {{PROJECT_NAME}}!"),
) : GreetingRepository {
    override suspend fun loadGreeting(name: String): Greeting = response
}

class {{FEATURE_NAME}}ViewModelTest {

    private val dispatcher = StandardTestDispatcher()

    @BeforeTest
    fun setUp() = Dispatchers.setMain(dispatcher)

    @AfterTest
    fun tearDown() = Dispatchers.resetMain()

    @Test
    fun nameChangedUpdatesStateName() = runTest(dispatcher) {
        val vm = {{FEATURE_NAME}}ViewModel(GetGreetingUseCase(FakeGreetingRepository()))
        vm.onIntent({{FEATURE_NAME}}IntentUi.NameChanged("{{PROJECT_NAME}}"))
        assertEquals("{{PROJECT_NAME}}", vm.state.value.name)
    }

    @Test
    fun submitLoadsGreetingIntoState() = runTest(dispatcher) {
        val vm = {{FEATURE_NAME}}ViewModel(
            GetGreetingUseCase(FakeGreetingRepository(Greeting("Hello, {{PROJECT_NAME}}!"))),
        )
        vm.onIntent({{FEATURE_NAME}}IntentUi.NameChanged("{{PROJECT_NAME}}"))
        vm.onIntent({{FEATURE_NAME}}IntentUi.Submit)
        testScheduler.advanceUntilIdle()
        assertEquals("Hello, {{PROJECT_NAME}}!", vm.state.value.greeting)
        assertFalse(vm.state.value.isLoading)
    }
}
