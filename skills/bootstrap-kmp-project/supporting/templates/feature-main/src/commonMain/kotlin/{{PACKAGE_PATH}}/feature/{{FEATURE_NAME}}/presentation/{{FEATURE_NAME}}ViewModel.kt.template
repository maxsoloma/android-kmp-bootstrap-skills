package {{PACKAGE_BASE}}.feature.{{FEATURE_NAME}}.presentation

import androidx.lifecycle.viewModelScope
import {{PACKAGE_BASE}}.core.design.mvi.MviViewModel
import {{PACKAGE_BASE}}.feature.{{FEATURE_NAME}}.domain.GetGreetingUseCase
import kotlinx.coroutines.launch

class {{FEATURE_NAME}}ViewModel(
    private val getGreeting: GetGreetingUseCase,
) : MviViewModel<{{FEATURE_NAME}}StateUi, {{FEATURE_NAME}}IntentUi, {{FEATURE_NAME}}EffectUi>({{FEATURE_NAME}}StateUi()) {

    override fun handleIntent(intent: {{FEATURE_NAME}}IntentUi) {
        when (intent) {
            is {{FEATURE_NAME}}IntentUi.NameChanged -> updateState { it.copy(name = intent.value) }
            {{FEATURE_NAME}}IntentUi.Submit -> submit()
        }
    }

    private fun submit() {
        updateState { it.copy(isLoading = true) }
        viewModelScope.launch {
            runCatching { getGreeting(currentState.name) }
                .onSuccess { result ->
                    updateState { it.copy(greeting = result.text, isLoading = false) }
                }
                .onFailure { error ->
                    updateState { it.copy(isLoading = false) }
                    emitEffect({{FEATURE_NAME}}EffectUi.ShowError(error.message ?: "Unknown error"))
                }
        }
    }
}
