plugins {
    id("{{PACKAGE_BASE}}.convention.kmp-library")
    id("{{PACKAGE_BASE}}.convention.compose-multiplatform")
    id("{{PACKAGE_BASE}}.convention.koin")
    id("{{PACKAGE_BASE}}.convention.detekt")
    id("{{PACKAGE_BASE}}.convention.test")
    alias(libs.plugins.skie)
}

kotlin {
    androidLibrary {
        namespace = "{{PACKAGE_BASE}}.feature.{{FEATURE_NAME}}"
    }
    // feature:{{FEATURE_NAME}} produces the iOS framework consumed by iosApp (v1: single feature,
    // no umbrella aggregator). XCFramework + SKIE wired in Task 46.
    // iosX64 not published by CMP 1.11.1 — only iosArm64 + iosSimulatorArm64 (C9).
    val xcf = XCFramework("Shared")
    listOf(iosArm64(), iosSimulatorArm64()).forEach {
        it.binaries.framework {
            baseName = "Shared"
            isStatic = true
            xcf.add(this)
        }
    }
    sourceSets {
        commonMain.dependencies {
            implementation(project(":core:design"))
            implementation(project(":core:domain"))
            implementation(project(":core:di"))
            implementation(project(":core:utils"))
            implementation(libs.androidx.lifecycle.viewmodel)
            implementation(libs.koin.core)
            implementation(libs.kotlinx.coroutines.core)
        }
    }
}
