package {{PACKAGE_BASE}}.core.dma

import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.map

/**
 * Bridges a raw source stream to a domain stream by applying a [transform] per element.
 * Keeps presentation/data shaping out of repositories.
 */
class DataManipulationAdapter<RAW, DOMAIN>(
    private val transform: (RAW) -> DOMAIN,
) {
    fun adapt(source: Flow<List<RAW>>): Flow<List<DOMAIN>> =
        source.map { batch -> batch.map(transform) }
}
