package {{PACKAGE_BASE}}.core.database

import androidx.room.ConstructedBy
import androidx.room.Database
import androidx.room.RoomDatabase
import androidx.room.RoomDatabaseConstructor
import androidx.sqlite.driver.bundled.BundledSQLiteDriver
import {{PACKAGE_BASE}}.core.database.dao.TodoDao
import {{PACKAGE_BASE}}.core.database.entity.TodoEntity
import kotlinx.coroutines.CoroutineDispatcher

@Database(entities = [TodoEntity::class], version = 1)
@ConstructedBy(AppDatabaseConstructor::class)
abstract class AppDatabase : RoomDatabase() {
    abstract fun todoDao(): TodoDao
}

// SUPPRESS-RATIONALE: Room KSP generates the actual object per platform at build time
@Suppress("KotlinNoActualForExpect")
expect object AppDatabaseConstructor : RoomDatabaseConstructor<AppDatabase> {
    override fun initialize(): AppDatabase
}

internal expect fun ioDispatcher(): CoroutineDispatcher

fun getRoomDatabase(builder: RoomDatabase.Builder<AppDatabase>): AppDatabase =
    builder
        .setDriver(BundledSQLiteDriver())
        .setQueryCoroutineContext(ioDispatcher())
        .build()
