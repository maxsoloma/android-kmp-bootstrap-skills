package {{PACKAGE_BASE}}.core.auth

import platform.Foundation.NSUserDefaults

actual class SecureTokenStorage(private val defaults: NSUserDefaults = NSUserDefaults.standardUserDefaults) {
    actual fun readToken(): String? = defaults.stringForKey(KEY)
    actual fun writeToken(token: String?) {
        if (token == null) defaults.removeObjectForKey(KEY) else defaults.setObject(token, KEY)
    }

    private companion object {
        const val KEY = "auth_token"
    }
}
