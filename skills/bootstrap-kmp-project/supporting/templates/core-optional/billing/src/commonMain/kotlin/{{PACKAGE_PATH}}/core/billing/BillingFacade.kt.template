package {{PACKAGE_BASE}}.core.billing

data class Product(val id: String, val priceLabel: String)

sealed interface PurchaseResult {
    data class Success(val productId: String) : PurchaseResult
    data object Cancelled : PurchaseResult
    data class Failed(val message: String) : PurchaseResult
}

expect class BillingFacade {
    suspend fun products(ids: List<String>): List<Product>
    suspend fun purchase(productId: String): PurchaseResult
}
