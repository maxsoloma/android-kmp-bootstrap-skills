private var request: Job? = null
    fun fetch(onState: (NetworkState) -> Unit) {
        if (closed) return
        request?.cancel()
        onState(NetworkState(loading = true))
        request = scope.launch {
            try {
                val activeGraph = checkNotNull(graph) { storageError ?: "Counter graph unavailable" }
                val text = activeGraph.network.fetch()
                ensureActive()
                if (!closed) onState(NetworkState(text = text))
            } catch (e: CancellationException) {
                throw e
            } catch (e: Exception) {
                if (!closed && isActive) onState(NetworkState(error = e.message ?: "Request failed"))
            }
        }
    }
