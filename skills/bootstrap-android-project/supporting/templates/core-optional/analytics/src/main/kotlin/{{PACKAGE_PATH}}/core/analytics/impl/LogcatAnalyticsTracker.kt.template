package {{PACKAGE_BASE}}.core.analytics.impl

import android.util.Log
import {{PACKAGE_BASE}}.core.analytics.AnalyticsTracker
import {{PACKAGE_BASE}}.core.analytics.model.AnalyticsEvent
import javax.inject.Inject

internal class LogcatAnalyticsTracker @Inject constructor() : AnalyticsTracker {
    override fun trackEvent(event: AnalyticsEvent) {
        Log.d(TAG, "event=${event.name} params=${event.params}")
    }

    override fun setUserProperty(key: String, value: String) {
        Log.d(TAG, "userProperty $key=$value")
    }

    private companion object {
        const val TAG = "Analytics"
    }
}
