package {{PACKAGE_BASE}}.core.sync.manager

import {{PACKAGE_BASE}}.core.sync.handler.ChangeHandler
import {{PACKAGE_BASE}}.core.sync.model.PendingChange
import java.util.concurrent.ConcurrentLinkedQueue
import javax.inject.Inject
import javax.inject.Singleton

@Singleton
class PendingChangesManager @Inject constructor(
    private val handlers: Set<@JvmSuppressWildcards ChangeHandler>,
) {
    private val queue = ConcurrentLinkedQueue<PendingChange>()

    fun enqueue(change: PendingChange) {
        queue.add(change)
    }

    suspend fun flush(): Int {
        var processed = 0
        val iterator = queue.iterator()
        while (iterator.hasNext()) {
            val change = iterator.next()
            val handler = handlers.firstOrNull { it.key == change.key }
            if (handler != null && handler.handle(change)) {
                iterator.remove()
                processed++
            }
        }
        return processed
    }
}
