package {{PACKAGE_BASE}}.core.billing.impl

import android.content.Context
import androidx.datastore.preferences.core.booleanPreferencesKey
import androidx.datastore.preferences.core.edit
import androidx.datastore.preferences.preferencesDataStore
import {{PACKAGE_BASE}}.core.billing.PremiumStateRepository
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.map
import javax.inject.Inject
import javax.inject.Singleton

private val Context.billingStore by preferencesDataStore(name = "billing")

@Singleton
internal class PremiumStateRepositoryImpl @Inject constructor(
    private val context: Context,
) : PremiumStateRepository {

    override val isPremium: Flow<Boolean> =
        context.billingStore.data.map { it[IS_PREMIUM] ?: false }

    override suspend fun setPremium(premium: Boolean) {
        context.billingStore.edit { it[IS_PREMIUM] = premium }
    }

    private companion object {
        val IS_PREMIUM = booleanPreferencesKey("is_premium")
    }
}
