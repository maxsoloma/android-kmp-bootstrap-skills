package {{PACKAGE_BASE}}.core.database.preferences

import android.content.Context
import androidx.datastore.preferences.core.booleanPreferencesKey
import androidx.datastore.preferences.core.edit
import androidx.datastore.preferences.preferencesDataStore
import dagger.hilt.android.qualifiers.ApplicationContext
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.map
import javax.inject.Inject

private val Context.dataStore by preferencesDataStore(name = "app_prefs")

class AppPreferences @Inject constructor(
    @ApplicationContext private val context: Context,
) {
    val onboardingShown: Flow<Boolean> =
        context.dataStore.data.map { it[ONBOARDING_SHOWN] ?: false }

    suspend fun setOnboardingShown(value: Boolean) {
        context.dataStore.edit { it[ONBOARDING_SHOWN] = value }
    }

    private companion object {
        val ONBOARDING_SHOWN = booleanPreferencesKey("onboarding_shown")
    }
}
