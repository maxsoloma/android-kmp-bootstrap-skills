package {{PACKAGE_BASE}}.architecture

import com.lemonappdev.konsist.api.verify.assertFalse
import org.junit.jupiter.api.Test

class Rule03DomainModelPurityTest {

    private val forbiddenAnnotations = listOf(
        "Serializable",
        "SerialName",
        "Entity",
        "PrimaryKey",
        "ColumnInfo",
        "Embedded",
        "TypeConverter",
    )

    @Test
    fun `domain model classes carry no serialization or persistence annotations`() {
        ArchitectureScope.project.classes()
            .filter { it.resideInPackage("..domain.model..") }
            .assertFalse { clazz ->
                clazz.annotations.any { annotation ->
                    val simple = annotation.name.substringAfterLast('.')
                    forbiddenAnnotations.any { simple == it } || simple.startsWith("Json")
                }
            }
    }
}
