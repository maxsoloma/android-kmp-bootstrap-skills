package {{PACKAGE_BASE}}.architecture

import com.lemonappdev.konsist.api.ext.list.withNameEndingWith
import com.lemonappdev.konsist.api.verify.assertFalse
import org.junit.jupiter.api.Test

class Rule02RepositorySignatureTest {

    private val forbiddenSuffixes = listOf("Entity", "Dto", "Ui", "StateUi", "ActionUi", "EventUi")

    private fun typeIsForbidden(typeName: String?): Boolean {
        val simple = typeName?.substringAfterLast('.')?.substringBefore('<') ?: return false
        return forbiddenSuffixes.any { simple.endsWith(it) }
    }

    @Test
    fun `Repository interface public methods do not expose Entity, Dto, or Ui types`() {
        ArchitectureScope.project.interfaces()
            .withNameEndingWith("Repository")
            .assertFalse { repo ->
                repo.functions().any { fn ->
                    typeIsForbidden(fn.returnType?.name) ||
                        fn.parameters.any { typeIsForbidden(it.type.name) }
                }
            }
    }
}
