package {{PACKAGE_BASE}}.architecture

import com.lemonappdev.konsist.api.ext.list.withPackage
import com.lemonappdev.konsist.api.verify.assertFalse
import org.junit.jupiter.api.Test

class Rule01DomainIsolationTest {

    private val forbidden = listOf(
        ".data.",
        ".presentation.",
        ".ui.",
        ".database.entity.",
        ".network.api.",
    )

    @Test
    fun `domain repository and usecase files do not import data, presentation, ui, entity, or api types`() {
        ArchitectureScope.project.files
            .withPackage("..domain.repository..", "..domain.usecase..")
            .assertFalse { file ->
                file.imports.any { import ->
                    forbidden.any { import.name.contains(it) }
                }
            }
    }
}
