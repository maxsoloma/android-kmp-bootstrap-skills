package {{PACKAGE_BASE}}.architecture

import com.lemonappdev.konsist.api.ext.list.withNameEndingWith
import com.lemonappdev.konsist.api.verify.assertTrue
import org.junit.jupiter.api.Test

class Rule06MapperConformanceTest {

    private val acceptedMapperBaseNames = setOf("Mapper", "BidirectionalMapper")

    @Test
    fun `classes ending with Mapper implement the base Mapper interface`() {
        ArchitectureScope.project.classes()
            .withNameEndingWith("Mapper")
            .assertTrue { mapper ->
                mapper.parents().any { it.name.substringBefore('<') in acceptedMapperBaseNames }
            }
    }
}
