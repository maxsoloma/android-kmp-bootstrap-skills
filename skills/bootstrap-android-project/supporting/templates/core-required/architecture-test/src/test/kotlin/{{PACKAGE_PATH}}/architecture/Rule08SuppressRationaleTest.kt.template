package {{PACKAGE_BASE}}.architecture

import com.lemonappdev.konsist.api.verify.assertTrue
import org.junit.jupiter.api.Test
import org.yaml.snakeyaml.Yaml
import java.io.File

class Rule08SuppressRationaleTest {

    private val rationaleMarker = "// SUPPRESS-RATIONALE:"

    private val allowlist: Set<String> by lazy {
        val file = File("suppress-allowlist.yml")
        if (!file.exists()) return@lazy emptySet()
        @Suppress("UNCHECKED_CAST")
        val map = Yaml().load<Map<String, Any>>(file.readText()) ?: emptyMap()
        (map["allowedWithoutRationale"] as? List<String>).orEmpty().toSet()
    }

    private fun suppressedRuleNames(line: String): List<String> =
        Regex("""@(?:file:)?Suppress\(([^)]*)\)""").findAll(line)
            .flatMap { match ->
                Regex(""""([^"]+)"""").findAll(match.groupValues[1]).map { it.groupValues[1] }
            }
            .toList()

    @Test
    fun `suppress-allowlist yml exists in module working directory`() {
        val allowlistFile = File("suppress-allowlist.yml")
        check(allowlistFile.exists()) {
            "suppress-allowlist.yml not found at CWD='${File("").absolutePath}'. " +
                "Expected CWD to be core/architecture-test module directory."
        }
    }

    @Test
    fun `every Suppress annotation in main sources has a rationale or is allowlisted`() {
        ArchitectureScope.project.files
            .filter { !it.path.contains("/build/") }
            .assertTrue { file ->
                val lines = file.text.lines()
                lines.withIndex().all { (index, line) ->
                    if (!line.contains("@Suppress") && !line.contains("@file:Suppress")) return@all true
                    val ruleNames = suppressedRuleNames(line)
                    val allAllowlisted = ruleNames.isNotEmpty() && ruleNames.all { it in allowlist }
                    val precededByRationale = index > 0 && lines[index - 1].trim().startsWith(rationaleMarker)
                    allAllowlisted || precededByRationale
                }
            }
    }
}
