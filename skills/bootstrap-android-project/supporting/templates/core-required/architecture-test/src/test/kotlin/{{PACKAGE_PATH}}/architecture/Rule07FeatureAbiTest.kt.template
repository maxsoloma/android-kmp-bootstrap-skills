package {{PACKAGE_BASE}}.architecture

import com.lemonappdev.konsist.api.verify.assertFalse
import org.junit.jupiter.api.Test

class Rule07FeatureAbiTest {

    private val forbiddenInternalSegments = listOf(
        ".data.",
        ".presentation.",
        ".domain.repository.",
    )

    private fun featureName(packageName: String): String? {
        val marker = ".feature."
        val idx = packageName.indexOf(marker)
        if (idx < 0) return null
        return packageName.substring(idx + marker.length).substringBefore('.')
    }

    @Test
    fun `feature files do not import another feature's internal packages`() {
        ArchitectureScope.project.files
            .filter { it.packagee?.name?.contains(".feature.") == true }
            .assertFalse { file ->
                val ownFeature = featureName(file.packagee?.name.orEmpty())
                file.imports.any { import ->
                    val importedFeature = featureName(import.name)
                    importedFeature != null &&
                        importedFeature != ownFeature &&
                        forbiddenInternalSegments.any { import.name.contains(it) }
                }
            }
    }
}
